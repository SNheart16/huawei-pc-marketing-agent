{
  "openapi": "3.1.0",
  "info": {
    "title": "Huawei PC Marketing Agent — Geo API 协作契约",
    "version": "0.1.0-draft",
    "description": "新增地图能力的提议契约，用于 A/B/C 对齐和并行开发。未读取当前仓库，未实现或验证路由，不能作为已交付能力证明。所有 example、query_id、poi_id、坐标、距离和时间均为合成数据，不是高德真实响应。前端基于此文件模拟时必须显示模拟标识。高德原始响应由后端归一化，不能直接替代本契约。"
  },
  "servers": [
    {
      "url": "/",
      "description": "同源服务；沿用现有应用实际 host/port，禁止硬编码开发者机器地址"
    }
  ],
  "tags": [
    {
      "name": "Geo",
      "description": "地点查询和用户确认的地理上下文"
    }
  ],
  "paths": {
    "/api/geo/search": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "searchGeoPlaces",
        "summary": "按城市和关键字搜索门店或地点",
        "description": "只查询，不修改任务 revision。城市作为限定条件使用，防止同名地点跨城误选。",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "description": "门店名或地点名",
            "schema": {
              "type": "string",
              "description": "去除首尾空格后 1–100 字符",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "城市名或行政区代码",
            "schema": {
              "type": "string",
              "description": "1–100 字符",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "每页最多 20 条",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；无结果仍为 200、items=[]",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "query_id": "geo-query-example-store",
                    "expires_at": "2026-10-23T06:30:00Z",
                    "keyword": "示例门店",
                    "city": "杭州",
                    "page": 1,
                    "page_size": 10,
                    "has_more": false,
                    "items": [
                      {
                        "poi_id": "SYNTHETIC_STORE_001",
                        "name": "示例门店（合成测试数据）",
                        "address": "示例地址，不代表真实门店",
                        "location": {
                          "lng": 120.1,
                          "lat": 30.2,
                          "coordinate_system": "GCJ-02"
                        },
                        "type_code": null,
                        "category": "other",
                        "distance_m": null,
                        "source": {
                          "provider": "amap",
                          "queried_at": "2026-10-23T06:00:00Z",
                          "verification_scope": "provider_record_only",
                          "live": true
                        }
                      }
                    ],
                    "limitations": [
                      "地图地点记录不代表实时营业或官方认证。",
                      "周边地点不证明客流、客群构成、购买意愿或学校合作关系。"
                    ]
                  },
                  "error": null
                }
              }
            }
          },
          "400": {
            "description": "GEO_INVALID_ARGUMENT：参数或引用结构不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "GEO_RATE_LIMITED：应用限流或供应商配额限制；可返回 Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "GEO_UPSTREAM_ERROR：供应商连接或响应异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "GEO_NOT_CONFIGURED / GEO_PROVIDER_AUTH_FAILED：配置缺失或凭证无效；不暴露凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "GEO_TIMEOUT：供应商请求超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/geo/nearby": {
      "get": {
        "tags": [
          "Geo"
        ],
        "operationId": "searchNearbyPlaces",
        "summary": "查询指定坐标周边地点",
        "description": "接收 GCJ-02 坐标，以米为半径单位。category 是项目枚举，由服务端映射高德分类，不由 LLM 拼造分类码。只查询，不修改任务。",
        "parameters": [
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "description": "经度；GCJ-02",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "纬度；GCJ-02",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "半径（米）",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000,
              "default": 1500
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": true,
            "description": "学校、办公楼、商场、住宅、交通站点",
            "schema": {
              "type": "string",
              "enum": [
                "school",
                "office",
                "mall",
                "residential",
                "transit"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "页码",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "每页结果数",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；无结果仍为 200、items=[]",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NearbyResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "query_id": "geo-query-example-school",
                    "expires_at": "2026-10-23T06:30:00Z",
                    "center": {
                      "lng": 120.1,
                      "lat": 30.2,
                      "coordinate_system": "GCJ-02"
                    },
                    "radius_m": 1500,
                    "category": "school",
                    "page": 1,
                    "page_size": 10,
                    "has_more": false,
                    "items": [
                      {
                        "poi_id": "SYNTHETIC_SCHOOL_001",
                        "name": "示例学校（合成测试数据）",
                        "address": "示例地址，不代表真实学校",
                        "location": {
                          "lng": 120.101,
                          "lat": 30.201,
                          "coordinate_system": "GCJ-02"
                        },
                        "type_code": null,
                        "category": "school",
                        "distance_m": 150,
                        "source": {
                          "provider": "amap",
                          "queried_at": "2026-10-23T06:00:00Z",
                          "verification_scope": "provider_record_only",
                          "live": true
                        }
                      }
                    ],
                    "limitations": [
                      "地图地点记录不代表实时营业或官方认证。",
                      "周边地点不证明客流、客群构成、购买意愿或学校合作关系。"
                    ]
                  },
                  "error": null
                }
              }
            }
          },
          "400": {
            "description": "GEO_INVALID_ARGUMENT：参数或引用结构不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "GEO_RATE_LIMITED：应用限流或供应商配额限制；可返回 Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "GEO_UPSTREAM_ERROR：供应商连接或响应异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "GEO_NOT_CONFIGURED / GEO_PROVIDER_AUTH_FAILED：配置缺失或凭证无效；不暴露凭证",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "GEO_TIMEOUT：供应商请求超时",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/geo/context": {
      "post": {
        "tags": [
          "Geo"
        ],
        "operationId": "createGeoContext",
        "summary": "把用户选择的门店和周边地点转成服务端可信引用",
        "description": "只提交 query_id/poi_id，不提交自报名称、坐标、source 或 verified。服务端在当前访问会话内查找查询快照，确认各引用存在且有效。nearby_refs 最多 10 项、不得重复，必须来自以所选门店为中心的有效周边查询。本接口创建地理上下文，不修改营销任务或其 revision；保存到任务使用现有 understand/continue。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateContextRequest"
              },
              "example": {
                "store_ref": {
                  "query_id": "geo-query-example-store",
                  "poi_id": "SYNTHETIC_STORE_001"
                },
                "nearby_refs": [
                  {
                    "query_id": "geo-query-example-school",
                    "poi_id": "SYNTHETIC_SCHOOL_001"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "地理上下文创建成功，仍未写入营销任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateContextResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "geo_context_id": "geo-context-example-001",
                    "expires_at": "2026-10-23T06:30:00Z",
                    "store": {
                      "poi_id": "SYNTHETIC_STORE_001",
                      "name": "示例门店（合成测试数据）",
                      "address": "示例地址，不代表真实门店",
                      "location": {
                        "lng": 120.1,
                        "lat": 30.2,
                        "coordinate_system": "GCJ-02"
                      },
                      "type_code": null,
                      "category": "other",
                      "distance_m": null,
                      "source": {
                        "provider": "amap",
                        "queried_at": "2026-10-23T06:00:00Z",
                        "verification_scope": "provider_record_only",
                        "live": true
                      }
                    },
                    "nearby_places": [
                      {
                        "poi_id": "SYNTHETIC_SCHOOL_001",
                        "name": "示例学校（合成测试数据）",
                        "address": "示例地址，不代表真实学校",
                        "location": {
                          "lng": 120.101,
                          "lat": 30.201,
                          "coordinate_system": "GCJ-02"
                        },
                        "type_code": null,
                        "category": "school",
                        "distance_m": 150,
                        "source": {
                          "provider": "amap",
                          "queried_at": "2026-10-23T06:00:00Z",
                          "verification_scope": "provider_record_only",
                          "live": true
                        }
                      }
                    ],
                    "selection_source": "user_selection",
                    "selected_at": "2026-10-23T06:00:00Z",
                    "limitations": [
                      "地图地点记录不代表实时营业或官方认证。",
                      "周边地点不证明客流、客群构成、购买意愿或学校合作关系。"
                    ]
                  },
                  "error": null
                }
              }
            }
          },
          "400": {
            "description": "GEO_INVALID_ARGUMENT：结构无效或重复引用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "GEO_REFERENCE_NOT_FOUND：引用不存在、不属于当前访问会话或不在所引用快照中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "GEO_SELECTION_MISMATCH：周边结果不属于该门店中心",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "GEO_CONTEXT_EXPIRED：查询快照已过期，需重新查询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "data": null,
                  "error": {
                    "code": "GEO_CONTEXT_EXPIRED",
                    "message": "地点选择已过期，请重新查询并选择。",
                    "retryable": false
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "coordinate_system": {
            "type": "string",
            "const": "GCJ-02"
          }
        },
        "required": [
          "lng",
          "lat",
          "coordinate_system"
        ],
        "additionalProperties": false
      },
      "Source": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "const": "amap"
          },
          "queried_at": {
            "type": "string",
            "format": "date-time"
          },
          "verification_scope": {
            "type": "string",
            "const": "provider_record_only"
          },
          "live": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "provider",
          "queried_at",
          "verification_scope",
          "live"
        ],
        "additionalProperties": false
      },
      "Poi": {
        "type": "object",
        "properties": {
          "poi_id": {
            "type": "string",
            "description": "高德实际返回的地点 ID，不伪造",
            "minLength": 1,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "description": "地点名称",
            "minLength": 1,
            "maxLength": 200
          },
          "address": {
            "type": "string",
            "maxLength": 500
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "type_code": {
            "anyOf": [
              {
                "type": "string",
                "description": "供应商分类码",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "school",
              "office",
              "mall",
              "residential",
              "transit",
              "other"
            ]
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "description": "仅 nearby 返回的直线距离；非步行距离。搜索或无法取得时为 null。"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "poi_id",
          "name",
          "address",
          "location",
          "type_code",
          "category",
          "distance_m",
          "source"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "项目错误码",
            "minLength": 1,
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "description": "可展示的脱敏错误信息",
            "minLength": 1,
            "maxLength": 500
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "required": [
          "success",
          "data",
          "error"
        ],
        "additionalProperties": false
      },
      "SearchData": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string",
            "description": "本服务生成的查询快照 ID；不是高德请求 ID",
            "minLength": 1,
            "maxLength": 120
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "keyword": {
            "type": "string",
            "description": "规范化搜索词",
            "minLength": 1,
            "maxLength": 100
          },
          "city": {
            "type": "string",
            "description": "城市名称或行政区代码",
            "minLength": 1,
            "maxLength": 100
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "has_more": {
            "type": "boolean",
            "description": "仅在供应商可判断时表示仍有下一页；不得为得到完整地点清单不断翻页。"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Poi"
            },
            "maxItems": 20
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          }
        },
        "required": [
          "query_id",
          "expires_at",
          "keyword",
          "city",
          "page",
          "page_size",
          "has_more",
          "items",
          "limitations"
        ],
        "additionalProperties": false
      },
      "NearbyData": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string",
            "description": "服务端周边查询快照 ID",
            "minLength": 1,
            "maxLength": 120
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "center": {
            "$ref": "#/components/schemas/Location"
          },
          "radius_m": {
            "type": "integer",
            "minimum": 100,
            "maximum": 5000
          },
          "category": {
            "type": "string",
            "enum": [
              "school",
              "office",
              "mall",
              "residential",
              "transit"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "has_more": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Poi"
            },
            "maxItems": 20
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          }
        },
        "required": [
          "query_id",
          "expires_at",
          "center",
          "radius_m",
          "category",
          "page",
          "page_size",
          "has_more",
          "items",
          "limitations"
        ],
        "additionalProperties": false
      },
      "PoiReference": {
        "type": "object",
        "properties": {
          "query_id": {
            "type": "string",
            "description": "有效查询快照 ID",
            "minLength": 1,
            "maxLength": 120
          },
          "poi_id": {
            "type": "string",
            "description": "该快照中的实际地点 ID",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "query_id",
          "poi_id"
        ],
        "additionalProperties": false
      },
      "CreateContextRequest": {
        "type": "object",
