# start-content-b.ps1 loads the explicit .env.content.local file (or -Config path).
# Direct app.py uses process environment only; no desktop credentials are discovered.
# Offline strategy assembly + real SVG layout works with no model configuration.
CONTENT_DATA_DIR=.content-data

# Reuse the existing project LLMClient (optional, actual generation needs all three).
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-locally
LLM_MODEL=your-supported-model
LLM_API_TYPE=chat_completions

# This demo uses only pre-generated materials. The server rejects ai_reference,
# and no image-generation credential is required or loaded by this mode.
# The following names remain only for older non-demo integrations.
IMAGE_BASE_URL=https://your-provider.example/v1
IMAGE_API_KEY=replace-locally
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT=300

# Member A implements this endpoint. Local HTTP or remote HTTPS.
FACT_CHECK_FINAL_URL=http://127.0.0.1:8000/api/facts/check-final
FACT_CHECK_API_KEY=
